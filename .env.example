# Copy to .env when you need to override defaults. Values are literal.
MASTERMONK_HOST=127.0.0.1
MASTERMONK_PORT=8787
MASTERMONK_DATA_DIR=runtime
MASTERMONK_SYNC_MODE=embedded
MASTERMONK_INTERVAL=900
# Public HTTPS origin for a shared instance. Leave blank for direct local use.
MASTERMONK_BASE_URL=
MASTERMONK_ALLOWED_HOSTS=
MASTERMONK_TRUSTED_PROXY=
# Public-source intelligence is readable without an account. Private tools remain protected.
MASTERMONK_PUBLIC_CATALOG=1

# Optional evidence-bounded AI reading assistant. Leave empty to keep it disabled.
# Supply an OpenAI-compatible chat-completions endpoint and model. HTTPS is required
# unless the endpoint is on localhost/127.0.0.1.
MASTERMONK_AI_ENDPOINT=
MASTERMONK_AI_MODEL=
MASTERMONK_AI_API_KEY=
# Optional provider credentials
MASTERMONK_NVD_API_KEY=
MASTERMONK_GITHUB_TOKEN=
# Email requires operator configuration.
MASTERMONK_SMTP_HOST=
MASTERMONK_SMTP_PORT=587
MASTERMONK_SMTP_FROM=
MASTERMONK_SMTP_USER=
MASTERMONK_SMTP_PASSWORD=
MASTERMONK_SMTP_SSL=0
# Optional HMAC signing secret for webhook receivers.
MASTERMONK_WEBHOOK_SECRET=
